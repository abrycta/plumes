{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plumes.krtmtthw.dev/schemas/story.schema.json",
  "title": "Story read model: <version>/story/<id>.json",
  "description": "A dated, stepped story (Taal January 2020 at M1, Kanlaon 2024 at M1.1). Steps reference series ids of the volcano read model, so the page shows the same data the volcano view does. Generated stories (STORIES-PLAN Part B) add generator, episodeIds, score and status, and per step kind, sentences and absent; all additive, so hand-built stories stay valid.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["kind", "id", "volcanoId", "title", "span", "steps", "provenance"],
  "properties": {
    "kind": { "const": "story" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "volcanoId": { "type": "string" },
    "volcanoFile": { "type": "string", "description": "Path of the volcano read model the steps refer to" },
    "title": { "$ref": "common.schema.json#/$defs/localText" },
    "summary": { "$ref": "common.schema.json#/$defs/localText" },
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": { "start": { "$ref": "common.schema.json#/$defs/date" }, "end": { "$ref": "common.schema.json#/$defs/date" } }
    },
    "status": { "enum": ["draft", "reviewed"], "description": "Derived: reviewed only when every step is. Drafts are hidden on the site unless the preview parameter is set (ST1)" },
    "generator": {
      "type": "object",
      "required": ["name", "version", "catalogueVersion"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "catalogueVersion": { "type": "integer" } },
      "additionalProperties": false
    },
    "episodeIds": { "type": "array", "items": { "type": "string" }, "description": "The GVP eruptions and PHIVOLCS alert windows merged into this event (ST6)" },
    "score": { "$ref": "#/$defs/score" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "title", "text", "series", "figures"],
        "properties": {
          "id": { "type": "string" },
          "start": { "$ref": "common.schema.json#/$defs/date" },
          "end": { "$ref": "common.schema.json#/$defs/date" },
          "title": { "$ref": "common.schema.json#/$defs/localText" },
          "text": { "$ref": "common.schema.json#/$defs/localText" },
          "status": { "enum": ["draft", "reviewed"] },
          "kind": { "enum": ["before", "onset", "course", "after"], "description": "The step's place in before → onset → course → after (ST3); id stays free" },
          "sentences": {
            "type": "array",
            "description": "The rendered template sentences that make up text, in order",
            "items": {
              "type": "object",
              "required": ["template", "text", "figures", "sources"],
              "properties": {
                "template": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
                "text": { "$ref": "common.schema.json#/$defs/localText" },
                "figures": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Indexes into the step's figures" },
                "sources": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "absent": {
            "type": "array",
            "description": "Fixed reasons shown when the step has no fact sentence (STORIES-PLAN §B4)",
            "items": {
              "type": "object",
              "required": ["why", "text"],
              "properties": { "why": { "type": "string", "pattern": "^WHY-[A-Z0-9-]+$" }, "text": { "$ref": "common.schema.json#/$defs/localText" } },
              "additionalProperties": false
            }
          },
          "series": { "type": "array", "items": { "type": "string" }, "description": "Series ids (daily/events keys, or 'bulletins', 'advisories', 'displacement') to show" },
          "figures": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/figure" } },
          "assets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/asset" } },
          "map": {
            "type": "object",
            "properties": {
              "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[lon, lat]" },
              "zoom": { "type": "number" },
              "layers": { "type": "array", "items": { "type": "string" } },
              "month": { "$ref": "common.schema.json#/$defs/month" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "winds": {
      "type": "object",
      "description": "ERA5 pressure-level winds at the volcano, for the wind arrows",
      "required": ["source", "point", "cols", "rows"],
      "properties": {
        "source": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourceId" } },
        "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "[lon, lat] of the grid point" },
        "cols": { "const": ["time", "hPa", "u", "v", "speedMs", "dirToDeg"] },
        "rows": { "type": "array", "items": { "type": "array", "minItems": 6, "maxItems": 6 } }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": ["families", "steps", "tier"],
      "properties": {
        "families": { "type": "integer", "minimum": 0, "description": "Fact families with at least one sentence; rain and population are context and do not count" },
        "steps": { "type": "integer", "minimum": 0, "description": "Steps with at least one fact sentence" },
        "tier": { "enum": ["story", "reading", "none"] }
      },
      "additionalProperties": false
    }
  }
}
