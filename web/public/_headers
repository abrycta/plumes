# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/
# When several rules match, values of the same header are joined with a comma, so Cache-Control is set
# only on non-overlapping paths below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Data: the published versions on GitHub Pages (krtmtthw.dev/plumes/data/, the user site's custom domain; the
  # abrycta.github.io URL redirects there) and the Hugging Face mirror (resolve URLs redirect to *.hf.co, which also
  # answers PMTiles range requests); basemap: OpenFreeMap (style, tiles, glyphs, sprites). Add new hosts to connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://krtmtthw.dev https://abrycta.github.io https://huggingface.co https://*.hf.co; font-src 'self' data:; connect-src 'self' data: https://krtmtthw.dev https://abrycta.github.io https://huggingface.co https://*.huggingface.co https://*.hf.co https://tiles.openfreemap.org; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Vite emits content-hashed file names here, so they never change in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data versions (v1/, v2/, ...) are immutable once published. The deployed site reads them from GitHub Pages and the
# Hugging Face mirror (config.json), so these two rules only apply if a version is ever served from this origin.
/data/v*
  Cache-Control: public, max-age=31536000, immutable

# The pointer to the current data version: short cache so a new release shows up quickly.
/data/latest.json
  Cache-Control: public, max-age=60, must-revalidate

# Runtime configuration: data hosts change without a rebuild.
/config.json
  Cache-Control: public, max-age=0, must-revalidate

# Bundled coastline (Natural Earth, public domain): the offline basemap and the static map.
/basemap/*
  Cache-Control: public, max-age=86400

# Akari's pre-paint theme script (stable name, render-blocking): short TTL so upgrades land quickly.
/theme-init.js
  Cache-Control: public, max-age=300

# The HTML entry point must always revalidate so new deploys show up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The embed (embed.html, served at /embed) that krtmtthw.dev frames: the global framing rules are detached and the
# CSP set again with frame-ancestors https://krtmtthw.dev only. Every other path keeps DENY and 'none'.
/embed
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://krtmtthw.dev https://abrycta.github.io https://huggingface.co https://*.hf.co; font-src 'self' data:; connect-src 'self' data: https://krtmtthw.dev https://abrycta.github.io https://huggingface.co https://*.huggingface.co https://*.hf.co https://tiles.openfreemap.org; frame-ancestors https://krtmtthw.dev; base-uri 'self'; object-src 'none'
  Cache-Control: public, max-age=0, must-revalidate

/embed-pack/*
  Cache-Control: public, max-age=3600

# The production *.pages.dev hosts (and preview branches) duplicate the app: keep them out of search indexes.
# The /api Pages Function sets X-Robots-Tag: noindex itself (_headers rules don't apply to Function responses).
https://plumes.pages.dev/*
  X-Robots-Tag: noindex
https://:branch.plumes.pages.dev/*
  X-Robots-Tag: noindex
