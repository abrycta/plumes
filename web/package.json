{
  "name": "plumes-web",
  "private": true,
  "version": "0.1.0",
  "description": "Plumes web app: a retrospective record of 24 Philippine volcanoes (static read models, Akari, MapLibre).",
  "author": "Kurt",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install ${CI:+--with-deps} chromium webkit",
    "sources": "uv run --no-project --with pyyaml python scripts/extract_sources.py"
  },
  "dependencies": {
    "@abrycta/akari": "^0.20.1",
    "@mapbox/vector-tile": "^3.0.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.15.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "@scarf/scarf": false
  }
}
